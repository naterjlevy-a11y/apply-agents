# ---- LLM (any OpenAI-compatible provider) ----
# nvidia | openrouter | custom
LLM_PROVIDER=nvidia
# Checked against NVIDIA's live model list on 2026-10-04.
# Fast + good at following strict JSON instructions. Second one is tried if the first fails.
LLM_MODEL=deepseek-ai/deepseek-v4.1-flash
LLM_BACKUP_MODEL=z-ai/glm-5.3
# Free key: https://build.nvidia.com  (sign in, open any model, "Get API Key")
NVIDIA_API_KEY=
NVIDIA_RPM=35

# Optional fallback when NVIDIA is rate-limited or down. Free key: https://openrouter.ai/keys
LLM_FALLBACK_PROVIDER=
LLM_FALLBACK_MODEL=nvidia/nemotron-3-super-120b-a12b:free
OPENROUTER_API_KEY=
OPENROUTER_RPM=18

# Any other OpenAI-compatible endpoint (LM Studio, Ollama, Groq...): set LLM_PROVIDER=custom
CUSTOM_BASE_URL=
CUSTOM_API_KEY=

LLM_MAX_RETRIES=4
LLM_MAX_PARALLEL=2

# ---- Paths (defaults are inside this folder) ----
# Per-job folders with a tailored resume + cover letter: <APPLICATIONS_DIR>/Ready/<Company - Role>/
APPLICATIONS_DIR=
# CSV that gets a row after every submission
APPLIED_LOG=
# The only facts Claude may use when it writes an essay answer (see facts.example.md)
CLAUDE_FACTS=

# ---- Agents ----
MAX_CONCURRENT_AGENTS=3
HEADLESS=false
PORT=8765
